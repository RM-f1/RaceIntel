# Optional explicit SQLite database path (overrides auto-detection of data/raceintel.db and tests/fixtures/ci.db)
RACEINTEL_DB_PATH=

# Required only for admin sync endpoints (POST /analytics/sync)
RACEINTEL_ADMIN_KEY=

# Optional Google Gemini API key (leave empty or set RACEINTEL_OFFLINE=1 for offline mock mode)
GEMINI_API_KEY=
RACEINTEL_OFFLINE=0

# FastAPI backend base URL consumed by the Streamlit frontend
RACEINTEL_API_URL=http://127.0.0.1:8001
